OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
EMAIL_SIGNIN_ENABLED=false
SUPABASE_SECRET_KEY=
# Server-only secret. When set, exports are HMAC-signed and in-app restore accepts
# only unmodified backups signed with this key. Rotating it invalidates old backups
# for in-app restore (scripts/restore-backup.py still works offline).
BACKUP_SIGNING_KEY=
# Only for an isolated loopback Worker without Supabase (integration tests).
# Never set this on a public deployment.
HOSTING_IDENTITY=
